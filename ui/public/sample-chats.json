     "create_time": 1791312070.0,
     "update_time": null,
     "content": {
      "content_type": "text",
      "parts": [
       "I'm seriously thinking about moving to Lisbon in January. My lease here ends November 30 and I have to give notice by November 15. What should I sort out first?"
      ]
     },
     "status": "finished_successfully",
     "end_turn": null,
     "weight": 1.0,
     "metadata": {},
     "recipient": "all",
