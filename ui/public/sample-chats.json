     "create_time": 1791312242.0,
     "update_time": null,
     "content": {
      "content_type": "text",
      "parts": [
       "Honestly I'm torn between Lisbon and Porto. Porto is cheaper and calmer, but most of the people I know are in Lisbon."
      ]
     },
     "status": "finished_successfully",
     "end_turn": null,
     "weight": 1.0,
     "metadata": {},
     "recipient": "all",
     "channel": null
